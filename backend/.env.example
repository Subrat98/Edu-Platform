# Django / central control-plane database
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://college_platform:replace-with-a-strong-password@127.0.0.1:5432/college_platform_central
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL server used for the isolated tenant databases
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=5432
TENANT_DB_USER=college_platform
TENANT_DB_PASSWORD=replace-with-a-strong-password
TENANT_BASE_DOMAIN=example.com

